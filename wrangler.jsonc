{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caldav",
	"main": "src/index.tsx",
	"compatibility_date": "2026-01-26",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hono-caldav",
			"database_id": "256b87d7-86a1-400b-a19d-004796e611d2",
		},
	],
	"ai": {
		"binding": "AI",
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	// Email Worker setup for iMIP receive:
	// 1. Enable Email Routing in Cloudflare Dashboard for your domain
	// 2. Add a custom address (e.g., scheduling@yourdomain.com) → route to this Worker
	// 3. The `email` handler in src/index.tsx will process incoming iMIP emails
	// 4. RESEND_API_KEY and SCHEDULING_EMAIL should be set as secrets:
	//    wrangler secret put RESEND_API_KEY
	//    wrangler secret put SCHEDULING_EMAIL
}
